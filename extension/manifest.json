{
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fihrist"
  },
  "background": {
    "service_worker": "background.js"
  },
  "description": "Save the current tab to your Fihrist bookmark library in one click, and search your library without leaving the tab.",
  "host_permissions": [
    "https://fihristy.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "manifest_version": 3,
  "content_scripts": [
    { "matches": ["https://fihristy.vercel.app/*"], "js": ["content.js"] }
  ],
  "name": "Fihrist — Save to library",
  "options_page": "options.html",
  "permissions": ["activeTab", "contextMenus", "tabs", "storage"],
  "version": "1.0.0"
}
