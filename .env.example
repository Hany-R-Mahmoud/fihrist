# Local authentication is the development default. Production always requires OAuth.
# To test Manus OAuth locally, set both values to oauth.
# AUTH_MODE=oauth
# VITE_AUTH_MODE=oauth
# Optional. `pnpm dev` starts the bundled local database when this is omitted.
# DATABASE_URL=mysql://fihrist:fihrist@127.0.0.1:3306/fihrist

# Optional: required only for Manus OAuth mode.
# JWT_SECRET=
# VITE_APP_ID=
# OAUTH_SERVER_URL=
# VITE_OAUTH_PORTAL_URL=
# OWNER_OPEN_ID=

# Optional: required for AI analysis and other Forge-backed features.
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=

# Optional analytics.
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_WEBSITE_ID=
