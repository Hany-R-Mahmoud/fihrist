# Optional: override the local SQLite data directory.
# FIHRIST_DATA_DIR=

# Optional: enable manual AI analysis with a compatible provider.
# FIHRIST_AI_BASE_URL=
# FIHRIST_AI_API_KEY=
# FIHRIST_AI_MODEL=

# Optional: allow this installed Chrome extension to call the local API.
# FIHRIST_EXTENSION_ORIGINS=chrome-extension://YOUR_32_CHARACTER_EXTENSION_ID

# Vercel Production cloud mode (set in Vercel, not in this file).
# FIHRIST_MODE=cloud
# VITE_FIHRIST_MODE=cloud
# NEON_AUTH_BASE_URL=https://ep-mute-king-bawaaobf.neonauth.c-8.eu-central-1.aws.neon.tech/fihrist/auth
# VITE_NEON_AUTH_BASE_URL=https://ep-mute-king-bawaaobf.neonauth.c-8.eu-central-1.aws.neon.tech/fihrist/auth
# VITE_GOOGLE_OAUTH_READY=true
# Production custom credentials and callback verified on 2026-10-17; rebuild required.
# DATABASE_URL and CRON_SECRET are server-only secrets, supplied securely in Vercel.
# Google Client ID/Secret belong in Neon Auth, never in VITE_* variables.
